{
  "pluginAlias": "MagicHomePro",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "required": ["name"],
    "additionalProperties": false,
    "properties": {
      "name": { "title": "Name", "type": "string", "default": "Magic Home Pro" },
      "logLevel": {
        "title": "Log level", "type": "string", "default": "info",
        "enum": ["error", "warn", "info", "debug", "trace"]
      },
      "discovery": {
        "title": "Discovery", "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "title": "Enable automatic discovery", "type": "boolean", "default": true },
          "timeoutMs": { "title": "Reply window / TCP timeout (ms)", "type": "integer", "default": 3000, "minimum": 250, "maximum": 30000 },
          "retries": { "title": "UDP retries", "type": "integer", "default": 3, "minimum": 1, "maximum": 10 },
          "retryDelayMs": { "title": "Retry delay (ms)", "type": "integer", "default": 250, "minimum": 0, "maximum": 10000 },
          "limitedBroadcast": { "title": "Try 255.255.255.255", "type": "boolean", "default": true },
          "targets": {
            "title": "Discovery targets", "description": "Individual IPs, directed broadcasts, or IPv4 CIDRs.",
            "type": "array", "default": [], "items": { "type": "string" }
          },
          "interfaces": { "title": "Interface names (blank means all)", "type": "array", "default": [], "items": { "type": "string" } },
          "subnetProbe": {
            "title": "Bounded subnet probing", "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "title": "Enable explicit CIDR probing", "type": "boolean", "default": false },
              "cidrs": { "title": "CIDRs", "type": "array", "default": [], "items": { "type": "string" } },
              "concurrency": { "title": "Concurrency", "type": "integer", "default": 10, "minimum": 1, "maximum": 64 },
              "ratePerSecond": { "title": "Maximum probes/second", "type": "integer", "default": 20, "minimum": 1, "maximum": 200 },
              "allowPublic": { "title": "Allow non-private ranges (unsafe)", "type": "boolean", "default": false }
            }
          }
        }
      },
      "devices": {
        "title": "Manual devices", "type": "array", "default": [],
        "items": {
          "type": "object",
          "required": ["host"],
          "additionalProperties": false,
          "properties": {
            "name": { "title": "Name", "type": "string" },
            "location": {
              "title": "Location / room label",
              "description": "Stored as a plugin label. Select the actual Apple Home room in the Home app.",
              "type": "string"
            },
            "host": { "title": "IPv4 address", "type": "string", "format": "ipv4" },
            "mac": { "title": "MAC address (recommended for stable identity)", "type": "string" },
            "deviceType": {
              "title": "Device type", "type": "string", "default": "lightbulb",
              "enum": ["led-strip", "lightbulb"],
              "enumNames": ["LED Strip", "Lightbulb"]
            },
            "cctControl": {
              "title": "Force CCT control", "type": "boolean", "default": false,
              "description": "Expose colour-temperature control even when it is not reported by the controller."
            },
            "colorControl": {
              "title": "Colour control", "type": "string", "default": "auto",
              "enum": ["auto", "rgb", "rgbw", "rgbww", "rgbcct", "rgbwcct", "rgbwwcw"],
              "enumNames": ["Automatic (detected)", "RGB", "RGBW", "RGBWW", "RGBCCT", "RGBWCCT", "RGBWWCW"]
            },
            "colorOrder": {
              "title": "Colour order", "type": "string", "default": "RGBWC",
              "description": "Logical colour connected to each controller output, for example GRB when red and green are swapped.",
              "pattern": "^[RGBWC]{1,5}$"
            }
          }
        }
      }
    }
  },
  "layout": ["name", "logLevel", "discovery", "devices"]
}
