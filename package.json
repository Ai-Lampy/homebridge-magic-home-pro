{
  "name": "homebridge-magic-home-pro",
  "displayName": "Magic Home Pro",
  "version": "0.6.1",
  "description": "Local-only Homebridge platform for MagicHome and LEDnet Wi-Fi controllers",
  "author": "Ai-Lampy",
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/lxmitch"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ai-Lampy/homebridge-magic-home-pro.git"
  },
  "bugs": {
    "url": "https://github.com/Ai-Lampy/homebridge-magic-home-pro/issues"
  },
  "homepage": "https://github.com/Ai-Lampy/homebridge-magic-home-pro#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": "./dist/index.js",
  "files": ["dist", "homebridge-ui", "config.schema.json", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": { "node": "^22.10.0 || ^24.0.0 || ^26.0.0", "homebridge": "^2.0.0" },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge",
    "homekit",
    "apple-home",
    "magic-home",
    "magic-home-pro",
    "magichome",
    "lednet",
    "led-controller",
    "wifi-led",
    "led-strip",
    "lightbulb",
    "dimmer",
    "rgb",
    "rgbw",
    "rgbww",
    "rgbcct",
    "cct",
    "smart-lighting",
    "local-control",
    "lan"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "clean": "rimraf dist coverage",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p tsconfig.json && vitest run && eslint . --max-warnings=0",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^26.2.0",
    "eslint": "9.39.5",
    "homebridge": "^2.3.0",
    "rimraf": "^6.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
